{
  "threshold": 0,
  "minLines": 8,
  "minTokens": 100,
  "mode": "strict",
  "reporters": ["console", "threshold"],
  "pattern": "sources/**/*.{ts,tsx}",
  "ignore": [
    "**/build/**",
    "**/coverage/**",
    "**/node_modules/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.d.ts",
    "**/test-setup.ts"
  ]
}
